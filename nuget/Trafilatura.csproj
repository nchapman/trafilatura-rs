<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Trafilatura</PackageId>
    <Version>0.3.0</Version>
    <Authors>Nathaniel Chapman</Authors>
    <Description>Extract readable content, comments, and metadata from web pages. High-performance Rust-based port of the trafilatura library with native bindings for .NET.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nchapman/trafilatura-rs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>html;extraction;web-scraping;content-extraction;nlp;trafilatura</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Native libraries arranged by RID under runtimes/ -->
  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
